@using F1Atlas.Core.Models
@if (Visible)
{
    <div class="circuit-popup">

        <div class="header">
            <button class="close-button" @onclick="Close">×</button>

            <h2 class="circuit-name">@CircuitName</h2>
        </div>

        <div class="stats">

            <div class="stat-section">
                <h3>Race Winner</h3>
                <p class="stat-driver">@CircuitStatistics?.Winner</p>
                <p class="stat-value">4 wins</p>
            </div>

            <div class="stat-section">
                <h3>Most Podiums</h3>
                <p class="stat-driver">Lewis Hamilton</p>
                <p class="stat-value">10 podiums</p>
            </div>

            <div class="stat-section">
                <h3>Most Pole Positions</h3>
                <p class="stat-driver">Lewis Hamilton</p>
                <p class="stat-value">8 poles</p>
            </div>

            <div class="stat-section">
                <h3>Most Starts</h3>
                <p class="stat-driver">Fernando Alonso</p>
                <p class="stat-value">19 starts</p>
            </div>

        </div>

    </div>
}

@code {
    [Parameter]
    public string? CircuitName { get; set; }

    [Parameter]
    public CircuitStatistics? CircuitStatistics { get; set;}

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }



    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}