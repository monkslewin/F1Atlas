@using F1Atlas.Core.Models
@if (Visible)
{
    <div class="circuit-popup">

        <div class="popup-header">
            <h2 class="popup-title">@PopupTitle</h2>
            <button class="close-button" @onclick="Close">×</button>
        </div>

        <div class="popup-body">

            <div class="stat-row race-winner">
                <div class="stat-left">
                    <span class="stat-label">Race Winner</span>
                    <p class="stat-name">@CircuitStatistics?.Winner</p>
                </div>
                <div class="stat-right">
                   <span class="stat-label">Win Margin</span>
                   <p class="stat-name">@CircuitStatistics?.WinMargin</p>
                </div>
            </div>

            <div class="stat-row">
                <div class="stat-left">
                    <span class="stat-label">Pole Position</span>
                    <p class="stat-name">@CircuitStatistics?.PolePosition</p>

                </div>
                <div class="stat-right">
                    <span class="stat-label">Final Position</span>
                    <p class="stat-name">P@(CircuitStatistics?.PolePositionResult)</p>
                </div>
            </div>

            <div class="stat-row">
                <div class="stat-left">
                    <span class="stat-label">Fastest Lap</span>
                    <p class="stat-name">@CircuitStatistics?.FastestLap</p>
                </div>
                <div class="stat-right">
                    <span class="stat-label">Lap Time</span>
                    <p class="stat-name">@CircuitStatistics?.FastestLapTime</p>
                </div>
            </div>

            

        </div>

    </div>
}

@code {
    [Parameter]
    public string? CircuitName { get; set; }

    [Parameter]
    public CircuitStatistics? CircuitStatistics { get; set; }

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string? PopupTitle =>
        CircuitStatistics is { Year: > 0, CircuitName.Length: > 0 }
            ? $"{CircuitStatistics.CircuitName} ({CircuitStatistics.Year})"
            : CircuitName;

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}