@page "/"
@rendermode InteractiveServer
@using F1Atlas.Web.Services
@using F1Atlas.Core.Models
@inject IJSRuntime JS
@inject CircuitService CircuitService

<PageTitle>F1Atlas</PageTitle>

<div class="globe-container" @ref="globeContainer">
</div>

@code {
    private ElementReference globeContainer;
    private List<Circuit> circuits = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            circuits = await CircuitService.GetCircuits();

            await JS.InvokeVoidAsync(
                "globe.initGlobe",
                globeContainer,
                circuits
            );
        }
    }
}