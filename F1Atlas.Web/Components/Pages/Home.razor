@page "/"
@rendermode InteractiveServer

@using F1Atlas.Web.Services
@using F1Atlas.Core.Models

@inject IJSRuntime JS
@inject CircuitService CircuitService

<PageTitle>F1Atlas</PageTitle>

<div class="globe-container" @ref="globeContainer"></div>

<div class="side-panel">
    <CircuitPopup
        CircuitName="@selectedCircuit"
        CircuitStatistics="@selectedStatistics"
        Visible="@showPopup"
        OnClose="@ClosePopup"
    />

    <YearSliderCard
        Min="1980"
        Max="2026"
        Value="@selectedYear"
        ValueChanged="@OnYearChanged"
    />
</div>

@code {
    private ElementReference globeContainer;

    private List<Circuit> circuits = new();

    private string? selectedCircuit;
    private bool showPopup = false;

    private int selectedYear = 2026;

    private DotNetObjectReference<Home>? dotNetReference;

    private CircuitStatistics? selectedStatistics;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            circuits = await CircuitService.GetCircuits(selectedYear);

            dotNetReference = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync(
                "globe.initGlobe",
                globeContainer,
                circuits,
                dotNetReference
            );
        }
    }

    [JSInvokable]
    public async Task CircuitClicked(string circuitName, string circuitId)
    {
        selectedCircuit = circuitName;
        showPopup = true;
        selectedStatistics =
        await CircuitService.GetCircuitStatistics(circuitId, selectedYear
        );

        StateHasChanged();
    }

    private void ClosePopup()
    {
        showPopup = false;
    }

    private async Task OnYearChanged(int newYear)
    {
        selectedYear = newYear;
        circuits = await CircuitService.GetCircuits(selectedYear);

        await JS.InvokeVoidAsync(
        "globe.updateCircuits",
        circuits
    );

    }

    public void Dispose()
    {
        dotNetReference?.Dispose();
    }
}